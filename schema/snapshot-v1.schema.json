{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runnel.dev/v1/snapshot.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "observed_at", "platform", "availability", "groups"],
  "properties": {
    "schema_version": {"const": "runnel.snapshot/v1"},
    "tool_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "platform": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/platform"},
    "availability": {"type": "array", "items": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/probe_availability"}},
    "groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/workflow_group"}
    }
  },
  "$defs": {
    "process_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "parent_pid", "cpu_time_ns", "cpu_time_delta_ns", "rss_bytes", "argv", "listening_connections", "established_connections", "availability", "evidence"],
      "properties": {
        "identity": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/process_identity"},
        "parent_pid": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "cpu_time_ns": {"type": "integer", "minimum": 0},
        "cpu_time_delta_ns": {"type": "integer", "minimum": 0},
        "rss_bytes": {"type": "integer", "minimum": 0},
        "tty": {"type": "string"},
        "cwd": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}},
        "listening_connections": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "established_connections": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "availability": {"type": "array", "items": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/probe_availability"}},
        "evidence": {"type": "array", "items": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/evidence_code"}, "uniqueItems": true}
      }
    },
    "resource_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_count", "cpu_time_ns", "rss_bytes"],
      "properties": {
        "process_count": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "cpu_time_ns": {"type": "integer", "minimum": 0},
        "rss_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "workflow_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "family", "classification", "attribution", "protection", "processes", "aggregate"],
      "properties": {
        "id": {"type": "string", "pattern": "^wf-[0-9a-f]{16}$"},
        "root": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/process_identity"},
        "family": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/workflow_family"},
        "classification": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/classification"},
        "attribution": {"type": "array", "items": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/evidence_code"}, "uniqueItems": true},
        "protection": {"type": "array", "items": {"$ref": "https://schemas.runnel.dev/v1/common.json#/$defs/evidence_code"}, "uniqueItems": true},
        "processes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/process_observation"}},
        "aggregate": {"$ref": "#/$defs/resource_aggregate"}
      }
    }
  }
}
